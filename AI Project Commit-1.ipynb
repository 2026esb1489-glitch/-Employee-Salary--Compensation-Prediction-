   "source": [
    "df = df.drop_duplicates().copy()\n",
    "\n",
    "target_column=\"salary_in_usd\"\n",
    "feature_columns=['experience_level', 'company_size','employment_type','job_title','company_location','work_year', 'remote_ratio']\n",
    "\n",
    "ordinal_features = ['experience_level', 'company_size']\n",
    "categorical_features = ['employment_type','job_title','company_location']\n",
    "numeric_features = ['work_year', 'remote_ratio']\n",
    "\n",
    "missing_columns = [\n",
    "    col for col in [target_column] + feature_columns\n",
    "    if col not in df.columns\n",
    "]\n",
    "\n",
    "if missing_columns:\n",
    "    print(\"Error: These columns do not exist:\", missing_columns)\n",
    "else:\n",
    "    print(\"Target:\", target_column)\n",
    "    print(\"Features:\", feature_columns)\n",
    "    display(df[[target_column] + feature_columns].head())"
   ]
