      "Input shape: (46637, 7)\n",
      "Target shape: (46637,)\n",
      "Numeric features: ['work_year', 'remote_ratio']\n",
      "Categorical features: ['employment_type', 'job_title', 'company_location']\n",
      "Ordinal features: ['experience_level', 'company_size']\n",
      "Rows available for modelling: 46637\n"
     ]
    }
   ],
   "source": [
    "#Defining Model,X and y\n",
    "model_df = df[feature_columns + [target_column]].copy()\n",
    "\n",
    "model_df[target_column] = pd.to_numeric(model_df[target_column], errors=\"coerce\")\n",
    "\n",
    "model_df = model_df.dropna(subset=[target_column])\n",
    "\n",
    "X = model_df[feature_columns]\n",
    "y = model_df[target_column]\n",
    "\n",
    "\n",
    "\n",
    "#Creating Pipelines for Each Feature type\n",
    "ordinal_transformer = Pipeline(\n",
    "    steps=[\n",
    "        ('imputer', SimpleImputer(strategy='most_frequent')),\n",
    "        (\n",
    "            'encoder',\n",
    "            OrdinalEncoder(\n",
    "                categories=[['EN', 'MI', 'SE', 'EX'], ['S', 'M', 'L']]\n",
    "            ),\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "categorical_transformer = Pipeline(\n",
    "    steps=[\n",
    "        ('imputer', SimpleImputer(strategy='most_frequent')),\n",
    "        (\n",
    "            'onehot',\n",
    "            OneHotEncoder(\n",
    "                max_categories=10,\n",
    "                drop='first',\n",
    "                sparse_output=False,\n",
    "                handle_unknown='ignore',\n",
    "            ),\n",
    "        ),\n",
    "    ]\n",
    ")\n",
    "\n",
    "numeric_transformer = Pipeline(\n",
    "    steps=[\n",
    "        ('imputer', SimpleImputer(strategy='median')),\n",
    "        ('scaler', StandardScaler()),\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Combine into ColumnTransformer\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('ord', ordinal_transformer, ['experience_level', 'company_size']),\n",
    "        (\n",
    "            'cat_auto',\n",
    "            categorical_transformer,\n",
    "            ['employment_type', 'job_title', 'company_location'],\n",
    "        ),\n",
    "        ('num', numeric_transformer, ['work_year', 'remote_ratio']),\n",
    "    ]\n",
    ")\n",
    "\n",
    "# Build & fit model pipeline\n",
    "model = Pipeline(\n",
    "    steps=[('preprocessor', preprocessor), ('regressor', LinearRegression())]\n",
    ")\n",
    "\n",
    "#Showing Some Basic information about the cleaned data\n",
    "print(\"Input shape:\", X.shape)\n",
    "print(\"Target shape:\", y.shape)\n",
    "print(\"Numeric features:\", numeric_features)\n",
    "print(\"Categorical features:\", categorical_features)\n",
    "print(\"Ordinal features:\", ordinal_features)\n",
    "print(\"Rows available for modelling:\", len(model_df))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "cf328352",
